<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxeLook - Admin Login</title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen m-0 font-sans">

  <div class="flex min-h-screen">

    <!-- LEFT SECTION (Show only on large screens) -->
    <div class="hidden lg:flex flex-1 bg-[#fce9e4] items-center justify-center overflow-hidden">
      <img src="/images/logo_forWhite.png" class="w-full h-full object-cover" alt="LuxeLook Logo">
    </div>

    <!-- RIGHT SECTION -->
    <div class="flex flex-1 bg-[#0e0e17] text-white items-center justify-center p-6">

      <div class="w-full max-w-sm">

        <!-- Small Screen Logo -->
        <div class="flex justify-center mb-6 lg:hidden">
          <img src="/images/logo-forBlack.png" class="w-28 h-28 object-contain" alt="LuxeLook Logo">
        </div>

        <h2 class="text-3xl font-semibold mb-4 text-center">Admin Login</h2>

        <!-- Error message -->
        <span class="text-red-500 text-sm block mb-2"><%= message %></span>

        <!-- Login form -->
        <form class="space-y-4">

          <div>
            <label for="email" class="block mb-1 text-sm">Email</label>
            <input type="email" id="email" name="email" 
              class="w-full p-3 rounded bg-[#1a1a27] border border-gray-700 text-white focus:ring-2 focus:ring-purple-500 outline-none"
              placeholder="Enter your email">
          </div>

          <div>
            <label for="password" class="block mb-1 text-sm">Password</label>
            <input type="password" id="password" name="password" 
              class="w-full p-3 rounded bg-[#1a1a27] border border-gray-700 text-white focus:ring-2 focus:ring-purple-500 outline-none"
              placeholder="Enter your password">
          </div>

          <button type="submit"
            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded" onclick="Login(event)">
            Log in
          </button>

        </form>

      </div>

    </div>

  </div>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    
  <script>
    async function Login(e){
      e.preventDefault();
      const email = document.getElementById('email').value.trim()
      const password = document.getElementById('password').value
      console.log(email)
      console.log(password)
      await axios.post('/admin/login',{email,password},{validateStatus:((status)=>status!==500)})
      .then((res)=>{
        if(!res.data.success){
          Swal.fire({
            icon:'error',
            title:'Error',
            text:res.data.message
          }).then(()=>{
            window.location.href = res.data.redirectUrl
          })
        }else{
          Swal.fire({
            icon:'success',
            title:'Success',
            text:res.data.message
          }).then(()=>{
            window.location.href = res.data.redirectUrl
          })
        }
      })
      .catch((error)=>{
        Swal.fire({
          icon:'error',
          title:'Error',
          text:'something error in admin login'
        }).then(()=>{
          window.location.href = '/admin/login'
        })
      })
    }
  </script>

</body>
</html>
